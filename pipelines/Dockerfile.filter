# Dockerfile for filter service with ML/NER capabilities
# Uses CUDA base image for GPU support

FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/0.9.26/install.sh | sh
ENV PATH="/root/.cargo/bin:/root/.local/bin:$PATH"

# Install Python dependencies
COPY pipelines/pyproject.toml ./pipelines/
RUN --mount=type=cache,target=/root/.cache/uv \
    cd pipelines && uv pip install --system ".[ml]"

# Install spaCy and the legal NER model
RUN pip install spacy>=3.7.0 && \
    pip install https://huggingface.co/opennyaiorg/en_legal_ner_trf/resolve/main/en_legal_ner_trf-any-py3-none-any.whl

# Copy application code
COPY pipelines /app/pipelines

CMD ["python", "-m", "pipelines.filter_judgments"]
