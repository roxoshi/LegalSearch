# Unified Pipeline Dockerfile
# REQUIRES base image: docker build -f docker/base-unified.Dockerfile -t legalsearch-base-unified .

ARG BASE_IMAGE=legalsearch-base-unified
FROM ${BASE_IMAGE}

WORKDIR /app
ENV PYTHONUNBUFFERED=1

# Just copy application code - all dependencies are in base image
COPY backend/app /app/app
COPY pipelines /app/pipelines
COPY etl /app/etl

CMD ["python", "-m", "pipelines.unified_pipeline"]
