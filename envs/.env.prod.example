# LegalSearch - Production Environment
# Copy to envs/.env.prod and fill in values
# Use strong, unique passwords for all secrets

ENVIRONMENT=prod

# PostgreSQL (use a strong password!)
POSTGRES_USER=legalsearch
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=search_db

# Backend (generate with: openssl rand -hex 32)
SECRET_KEY=<openssl-rand-hex-32>
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ML (for backend embedding at query time)
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Docker build images
BACKEND_BASE_IMAGE=python:3.13-slim

# Frontend
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Port bindings (host:container)
# DB binds to 127.0.0.1 only in prod compose override
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Staging server (for db-sync)
STAGING_HOST=<staging-ip>
STAGING_SSH_USER=<ssh-user>
