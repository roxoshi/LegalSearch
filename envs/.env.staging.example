# LegalSearch - Staging Environment
# Copy to envs/.env.staging and fill in values

ENVIRONMENT=staging

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=search_db

# Backend
SECRET_KEY=<openssl-rand-hex-32>
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# SMTP — MailPit local mock (docker-compose --profile mail)
# No auth needed, MailPit catches all emails at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@legalsearch.local

# ML / Pipeline
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
INGEST_BATCH_SIZE=50

# Docker build images
BACKEND_BASE_IMAGE=legalsearch-base-backend
UNIFIED_BASE_IMAGE=legalsearch-base-unified
FILTER_BASE_IMAGE=pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

# Frontend
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Port bindings (host:container)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database sync
SYNC_DUMP_DIR=.data/db-dumps
